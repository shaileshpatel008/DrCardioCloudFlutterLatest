# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# `/build/` only matches the repo root — the Android Gradle build (root
# project output in android/build/, plus every module's own
# android/*/build/, e.g. android/app/build/ where the built APK lands)
# needed its own entry; discovered when actually running a build for the
# first time this session surfaced it as an untracked directory.
**/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
